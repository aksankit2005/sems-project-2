# ====================================================================
# SEMS - Production Server Configuration & Credentials
# ====================================================================

PORT=5000

# --------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# You can provide DATABASE_URL directly (e.g. Supabase, Neon, or local):
# Example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/sems_db
# --------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sems_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=sems_db

# --------------------------------------------------------------------
# 2. Cloudinary Credentials (For storing Handover & Sports gear photos)
# Register at https://cloudinary.com (Free tier available)
# --------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
