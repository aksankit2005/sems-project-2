# ==========================================
# 1. RENDER (BACKEND ENVIRONMENT VARIABLES)
# ==========================================
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct)
# Example: postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Cloudinary (For student & equipment handover photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# 2. VERCEL (FRONTEND ENVIRONMENT VARIABLE)
# ==========================================
# Point this to your live Render backend URL
VITE_API_URL=https://your-backend-service-name.onrender.com
